# Required — Supabase (Auth, Postgres, Storage). Do not expose
# SUPABASE_SERVICE_ROLE_KEY to browser code; only NEXT_PUBLIC_* vars are
# bundled client-side.
NEXT_PUBLIC_SUPABASE_URL=your-supabase-project-url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Required — canonical production URL (no trailing slash). Used for
# email links, OG metadata, the sitemap, and custom-domain routing.
NEXT_PUBLIC_SITE_URL=https://your-domain.com

# Required — powers the AI receptionist/assistant agents.
OPENAI_API_KEY=your-openai-api-key

# Required — transactional email (booking confirmations, reminders,
# invites). RESEND_FROM defaults to onboarding@resend.dev if unset, but
# that default won't carry a business's own name as sender.
RESEND_API_KEY=your-resend-api-key
RESEND_FROM=bookings@your-domain.com

# Required — protects the scheduled cron routes (reminders, billing
# warnings, weekly insights, demo-data reset) from being called by anyone
# who finds the URL. Send as `Authorization: Bearer <value>` from your
# scheduler (e.g. Vercel Cron).
CRON_SECRET=a-long-random-string

# Required to accept live payments — Flutterwave, for both platform
# subscription billing AND customer deposits (a business links a bank
# account, never a payment-provider account of their own - see
# lib/flutterwave.ts). FLUTTERWAVE_SECRET_HASH is the value you set as
# the webhook secret hash in the Flutterwave dashboard; it verifies
# incoming webhook calls, it is not your API secret key.
# NEXT_PUBLIC_FLUTTERWAVE_PUBLIC_KEY is used client-side by the web
# booking page's inline checkout - a public key by design, same as any
# payment provider's client-side checkout key.
FLUTTERWAVE_SECRET_KEY=your-flutterwave-secret-key
FLUTTERWAVE_SECRET_HASH=your-flutterwave-webhook-secret-hash
NEXT_PUBLIC_FLUTTERWAVE_PUBLIC_KEY=your-flutterwave-public-key
# One Payment Plan per subscription tier, created by hand in the
# Flutterwave dashboard (Recurring Payments -> Payment Plans) - see
# app/api/billing/checkout/route.ts, which reads these by name via
# PLAN_ENV_KEY rather than a static process.env reference (why these two
# don't show up in a plain grep for process.env.* - noted here so they're
# not missed the way this whole file once was).
FLUTTERWAVE_PLAN_ID=your-core-plan-id
FLUTTERWAVE_PLAN_ID_BI=your-business-intelligence-plan-id

# Optional — Telegram channel. TELEGRAM_WEBHOOK_SECRET is a value you
# choose; set it on the bot's webhook registration and here, and requests
# without a matching secret are rejected.
TELEGRAM_WEBHOOK_SECRET=a-long-random-string

# Optional — WhatsApp and Messenger channels (Meta/Facebook). Both
# channels share one Meta app. META_WEBHOOK_VERIFY_TOKEN is a value you
# choose and register with Meta's webhook setup.
NEXT_PUBLIC_META_APP_ID=your-meta-app-id
NEXT_PUBLIC_META_CONFIG_ID=your-meta-embedded-signup-config-id
META_APP_SECRET=your-meta-app-secret
META_WEBHOOK_VERIFY_TOKEN=a-value-you-choose

# Optional — web push notifications for owners (new booking/cancellation
# alerts). Generate a pair with `npx web-push generate-vapid-keys`.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=your-vapid-public-key
VAPID_PRIVATE_KEY=your-vapid-private-key

# Optional — where lib/logger.ts sends an email for a critical failure
# (a payment that wouldn't verify, a payout account that failed to link,
# a paid slot lost to a race). Reuses RESEND_API_KEY/RESEND_FROM above,
# no separate account or service needed. Unset means logError still logs
# to stdout as always, it just never emails anyone - not a substitute
# for real monitoring (Sentry, etc.), a floor under it.
ALERT_EMAIL=you@your-domain.com
